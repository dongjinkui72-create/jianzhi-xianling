{
  "expo": {
    "name": "剪纸仙灵",
    "slug": "jianzhi-xianling",
    "version": "2.0.5",
    "scheme": "jianzhi",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#F7FAFF",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7FAFF"
    },
    "android": {
      "package": "com.jianzhi.xianling",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7FAFF"
      },
      "permissions": [],
      "softInputMode": "resize",
      "versionCode": 9
    },
    "ios": {
      "bundleIdentifier": "com.jianzhi.xianling",
      "supportsTablet": false,
      "infoPlist": {
        "UIUserInterfaceStyle": "Light"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-system-ui",
      "./plugins/withChatAppQueries",
      "./plugins/withAppListModule",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      "expo-splash-screen",
      "./plugins/withOverlayModule"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
