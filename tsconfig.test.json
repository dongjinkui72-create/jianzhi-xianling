{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": ".tmptest",
    "rootDir": "src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "strict": false,
    "resolveJsonModule": true,
    "jsx": "react"
  },
  "include": ["src/lib/**/*", "src/data/seed.ts", "src/data/chatAppRegistry.ts", "src/services/relayApi.ts", "src/services/radarFeed.ts", "src/services/headlessCheckin.ts", "src/lib/urlFallback.ts"]
}